---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetlifyForm from '../components/NetlifyForm.astro';
import { getEntry } from 'astro:content';

const configEntry = await getEntry('configuracoes', 'loja');
const loja = configEntry?.data ?? {
  nomeLoja: 'Mercado Bom Preço',
  telefone: '(11) 3456-7890',
  whatsapp: '5511999998888',
  endereco: 'Rua das Flores, 123 - Centro',
  cidadeBairro: 'São Paulo, SP',
  horarioSemana: '07h30 às 20h30',
  horarioDomingo: '08h00 às 13h30',
};

const enviadoComSucesso = Astro.url.searchParams.get('sucesso') === 'true';

const faqs = [
  {
    pergunta: 'Vocês fazem entrega a domicílio?',
    resposta: 'Sim! Entregamos no raio de até 5km da nossa loja. Basta montar seu carrinho no site e pagar com PIX, ou enviar sua listinha de compras no nosso WhatsApp.'
  },
  {
    pergunta: 'Quais cartões e vales-refeição vocês aceitam?',
    resposta: 'Aceitamos PIX, dinheiro, todos os cartões de crédito e débito (Visa, Mastercard, Elo, Hipercard) e os principais vales-alimentação e refeição: VR, Ticket, Alelo e Sodexo/Pluxee.'
  },
  {
    pergunta: 'Posso encomendar carnes temperadas ou cortes específicos no açougue?',
    resposta: 'Com certeza! Cortamos e limpamos a carne exatamente como você preferir e podemos temperar cortes especiais para seu churrasco ou almoço familiar sob encomenda prévia.'
  },
  {
    pergunta: 'Qual o melhor dia para comprar frutas e legumes frescos?',
    resposta: 'Temos entregas de hortifruti fresco diariamente, mas toda quarta e quinta-feira acontece a nossa tradicional Quarta Verde, com descontos especiais de até 30% em todo o setor!'
  }
];
---

<BaseLayout
  title={`Contato e Atendimento - ${loja.nomeLoja}`}
  description="Entre em contato com o Mercado Bom Preço. Tire dúvidas, faça encomendas ou envie sugestões diretamente para a nossa gerência."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    
    <!-- Notificação de Sucesso do Envio -->
    {enviadoComSucesso && (
      <div class="mb-8 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 flex items-center gap-3 shadow-sm">
        <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
          ✓
        </div>
        <div>
          <h4 class="font-bold text-sm">Mensagem enviada com sucesso!</h4>
          <p class="text-xs text-emerald-700 dark:text-emerald-400">Agradecemos o seu contato. Nossa equipe responderá o mais breve possível.</p>
        </div>
      </div>
    )}

    <!-- Cabeçalho -->
    <div class="max-w-2xl mb-12">
      <span class="text-xs uppercase font-extrabold tracking-wider text-brand-700 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/70 border border-brand-200/60 dark:border-brand-800/80 px-3.5 py-1.5 rounded-full inline-block mb-3">
        Canais de Atendimento
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Estamos Prontos para Te Ouvir
      </h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400 text-sm sm:text-base">
        Fale diretamente com nossa gerência por mensagem, telefone ou pelo WhatsApp oficial.
      </p>
    </div>

    <!-- Grid: Formulário + Cartões de Contato -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start mb-16">
      
      <!-- Lado Esquerdo: Formulário Netlify Forms (7 colunas) -->
      <div class="lg:col-span-7">
        <NetlifyForm />
      </div>

      <!-- Lado Direito: Informações Rápidas (5 colunas) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Cartão WhatsApp Direto -->
        <div class="bg-gradient-to-br from-emerald-600 to-emerald-700 text-white p-6 sm:p-8 rounded-3xl shadow-lg">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-2xl bg-white/20 flex items-center justify-center text-white">
              <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-lg">Pedidos no WhatsApp</h3>
              <p class="text-xs text-emerald-100">Resposta rápida em horário comercial</p>
            </div>
          </div>
          <p class="text-sm text-emerald-100 mb-6 leading-relaxed">
            Prefere pedir sem preencher formulários? Chame direto no nosso número e receba o encarte em PDF.
          </p>
          <a
            href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de falar com o atendimento do Mercado Bom Preço.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-white text-emerald-800 font-bold text-sm py-3 px-4 rounded-xl hover:bg-emerald-50 transition shadow"
          >
            Conversar no WhatsApp Agora
          </a>
        </div>

        <!-- Cartão de Contatos Telefônicos e Endereço -->
        <div class="bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-card space-y-5">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-slate-800 text-brand-600 dark:text-brand-400 flex items-center justify-center shrink-0">
              📞
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Telefone Fixo</span>
              <p class="text-base font-bold text-slate-900 dark:text-white">{loja.telefone}</p>
            </div>
          </div>

          <div class="flex items-start gap-4 pt-4 border-t border-slate-100 dark:border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-slate-800 text-brand-600 dark:text-brand-400 flex items-center justify-center shrink-0">
              📍
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Localização</span>
              <p class="text-sm font-semibold text-slate-900 dark:text-white leading-snug">
                {loja.endereco}<br />
                <span class="text-slate-500 dark:text-slate-400 font-normal">{loja.cidadeBairro}</span>
              </p>
              <a href="/localizacao" class="text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline mt-1 inline-block">
                Ver no mapa &rarr;
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 pt-4 border-t border-slate-100 dark:border-slate-800">
            <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-slate-800 text-brand-600 dark:text-brand-400 flex items-center justify-center shrink-0">
              🕒
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Horários de Atendimento</span>
              <p class="text-xs text-slate-700 dark:text-slate-300 mt-0.5">
                <strong>Segunda a Sábado:</strong> {loja.horarioSemana}<br />
                <strong>Domingos e Feriados:</strong> {loja.horarioDomingo}
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Seção de Dúvidas Frequentes (FAQ) -->
    <div class="bg-slate-50 dark:bg-slate-900/60 rounded-3xl p-6 sm:p-12 border border-slate-200/80 dark:border-slate-800">
      <div class="max-w-2xl mb-8">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Perguntas Frequentes (FAQ)</h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Confira as principais dúvidas dos nossos clientes sobre pedidos e funcionamento.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {faqs.map((faq) => (
          <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-2 flex items-start gap-2">
              <span class="text-brand-600 dark:text-brand-400 font-black">Q:</span>
              <span>{faq.pergunta}</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pl-5">
              {faq.resposta}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
