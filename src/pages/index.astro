---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromoBanner from '../components/PromoBanner.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryChips from '../components/CategoryChips.astro';
import { getCollection, getEntry } from 'astro:content';

// Busca dados da loja
const configEntry = await getEntry('configuracoes', 'loja');
const loja = configEntry?.data ?? {
  nomeLoja: 'Supermerk',
  slogan: 'Economia e qualidade pertinho de você!',
  telefone: '(99) 9175-6968',
  whatsapp: '559991756968',
  endereco: 'Rua das Flores, 123 - Centro',
  cidadeBairro: 'São Paulo, SP',
  horarioSemana: '07h30 às 20h30',
  horarioDomingo: '08h00 às 13h30',
  bannerTitulo: 'Preço Baixo de Verdade para Sua Família',
  bannerSubtitulo: 'Frutas fresquinhas colhidas no dia, carnes nobres e marcas de confiança pelo menor preço da região.',
  chavePix: '559991756968',
  tipoChavePix: 'Celular / WhatsApp',
  titularPix: 'Supermerk Ltda',
};

// Busca todos os produtos
const todosProdutos = await getCollection('produtos');

// Filtra produtos em promoção
const produtosEmPromocao = todosProdutos.filter(
  (p) => p.data.precoPromocional && p.data.precoPromocional < p.data.preco && p.data.disponivel
);

// Filtra produtos em destaque
const produtosDestaque = todosProdutos.filter((p) => p.data.destaque && p.data.disponivel);

// Categorias com imagens de capa para a seção visual
const categoriasCards = [
  { nome: 'Frutas e Verduras', desc: 'Frescor direto do produtor', img: 'https://images.unsplash.com/photo-1610832958506-aa56368176cf?auto=format&fit=crop&w=400&q=80' },
  { nome: 'Carnes e Aves', desc: 'Açougue inspecionado e cortes na hora', img: 'https://images.unsplash.com/photo-1603048588665-791ca8aea617?auto=format&fit=crop&w=400&q=80' },
  { nome: 'Laticínios', desc: 'Leites, queijos e iogurtes', img: 'https://images.unsplash.com/photo-1550583724-b2692b85b150?auto=format&fit=crop&w=400&q=80' },
  { nome: 'Mercearia', desc: 'Arroz, feijão, café e despensa', img: 'https://images.unsplash.com/photo-1586201375761-83865001e31c?auto=format&fit=crop&w=400&q=80' },
  { nome: 'Padaria', desc: 'Pão quente saindo do forno', img: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=400&q=80' },
  { nome: 'Bebidas', desc: 'Sucos integrais, refrigerantes e águas', img: 'https://images.unsplash.com/photo-1613478223719-2ab802602423?auto=format&fit=crop&w=400&q=80' },
];
---

<BaseLayout
  title={`${loja.nomeLoja} - Ofertas da Semana e Preço Baixo`}
  description={loja.slogan}
>
  <!-- 1. Banner Principal de Promoções com Alto Contraste -->
  <PromoBanner loja={loja} />

  <!-- 2. Filtro Rápido de Categorias -->
  <section class="reveal-on-scroll max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 my-6 sm:my-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span class="animate-mini-bounce">🏷️</span>
        <span>Categorias Populares</span>
      </h2>
      <a href="/produtos" class="group text-xs sm:text-sm font-semibold text-brand-700 dark:text-brand-400 hover:underline flex items-center gap-1">
        <span>Ver catálogo completo</span>
        <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>
    <CategoryChips baseUrl="/produtos" />
  </section>

  <!-- 3. Vitrine de Ofertas da Semana (com desconto ativo) -->
  {produtosEmPromocao.length > 0 && (
    <section class="reveal-on-scroll max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-6 sm:mb-8">
        <div>
          <span class="inline-flex items-center gap-1.5 text-[11px] sm:text-xs font-extrabold uppercase tracking-wider text-promo-600 dark:text-promo-400 bg-promo-50 dark:bg-promo-950/70 border border-promo-200 dark:border-promo-800/80 px-2.5 sm:px-3 py-1 rounded-full shadow-sm hover:scale-105 transition-transform">
            <span class="animate-flame">🔥</span>
            <span>Economia Garantida</span>
          </span>
          <h2 class="text-xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1.5 sm:mt-2">
            Ofertas <span class="animate-text-fire font-black">Imperdíveis da Semana</span>
          </h2>
          <p class="text-slate-500 dark:text-slate-400 text-xs sm:text-sm mt-1">
            Preços especiais com descontos exclusivos válidos enquanto durarem nossos estoques.
          </p>
        </div>
        <a
          href="/produtos"
          class="group inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-700 dark:text-brand-400 hover:text-brand-800"
        >
          <span>Conferir todas as ofertas</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {produtosEmPromocao.slice(0, 8).map((prod) => (
          <ProductCard
            slug={prod.slug}
            nome={prod.data.nome}
            preco={prod.data.preco}
            precoPromocional={prod.data.precoPromocional}
            unidade={prod.data.unidade}
            categoria={prod.data.categoria}
            descricao={prod.data.descricao}
            imagem={prod.data.imagem}
            disponivel={prod.data.disponivel}
            destaque={prod.data.destaque}
            whatsapp={loja.whatsapp}
          />
        ))}
      </div>
    </section>
  )}

  <!-- 4. Departamentos em Destaque (Cards Visuais com Imagem) -->
  <section class="reveal-on-scroll bg-slate-100/70 dark:bg-slate-900/60 py-10 sm:py-14 my-6 sm:my-8 border-y border-slate-200/80 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-700 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/70 border border-brand-200/60 dark:border-brand-800/80 px-3 py-1 rounded-full shadow-sm">
          Conheça Nossa Loja
        </span>
        <h2 class="text-xl sm:text-3xl font-black text-slate-900 dark:text-white mt-2 sm:mt-3">
          Tudo o Que Sua Casa Precisa em <span class="animate-text-violet font-black">Um Só Lugar</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1.5 sm:mt-2">
          Do hortifruti com produtos frescos da horta ao pão quentinho da padaria.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
        {categoriasCards.map((cat) => (
          <a
            href={`/produtos?categoria=${encodeURIComponent(cat.nome)}`}
            class="group card-hover-lift relative h-48 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 block"
          >
            <img
              src={cat.img}
              alt={cat.nome}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent"></div>
            <div class="absolute bottom-3 left-3 right-3 text-white">
              <h3 class="font-bold text-sm leading-tight group-hover:text-brand-300 transition-colors">
                {cat.nome}
              </h3>
              <p class="text-[10px] text-slate-300 line-clamp-1 mt-0.5">
                {cat.desc}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Produtos em Destaque Geral -->
  <section class="reveal-on-scroll max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="flex items-center justify-between mb-6 sm:mb-8">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand-700 dark:text-brand-400">Mais Procurados</span>
        <h2 class="text-xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Destaques <span class="animate-text-violet font-black">Selecionados</span>
        </h2>
      </div>
      <a
        href="/produtos"
        class="group text-xs sm:text-sm font-bold text-brand-700 dark:text-brand-400 hover:text-brand-800 flex items-center gap-1"
      >
        <span>Ver todos</span>
        <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {produtosDestaque.map((prod) => (
        <ProductCard
          slug={prod.slug}
          nome={prod.data.nome}
          preco={prod.data.preco}
          precoPromocional={prod.data.precoPromocional}
          unidade={prod.data.unidade}
          categoria={prod.data.categoria}
          descricao={prod.data.descricao}
          imagem={prod.data.imagem}
          disponivel={prod.data.disponivel}
          destaque={prod.data.destaque}
          whatsapp={loja.whatsapp}
        />
      ))}
    </div>
  </section>

  <!-- 6. Seção de Confiança / Benefícios do Mercado de Bairro -->
  <section class="reveal-on-scroll max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="bg-gradient-to-br from-brand-950 to-brand-900 text-white rounded-2xl sm:rounded-3xl p-6 sm:p-12 shadow-xl border border-brand-800/60">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 text-center md:text-left">
        <div class="flex flex-col items-center md:items-start group">
          <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-2xl mb-3 sm:mb-4 animate-float group-hover:scale-110 transition-transform">
            🥦
          </div>
          <h3 class="text-base sm:text-lg font-bold group-hover:text-brand-300 transition-colors">Hortifruti Direto do Produtor</h3>
          <p class="text-xs text-brand-100/90 mt-1.5 sm:mt-2 leading-relaxed">
            Abastecemos nossas bancas de verduras e legumes diariamente para garantir o máximo de sabor e nutrientes.
          </p>
        </div>

        <div class="flex flex-col items-center md:items-start group">
          <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-2xl mb-3 sm:mb-4 animate-float-delayed group-hover:scale-110 transition-transform">
            🥩
          </div>
          <h3 class="text-base sm:text-lg font-bold group-hover:text-promo-300 transition-colors">Açougue com Corte Sob Medida</h3>
          <p class="text-xs text-brand-100/90 mt-1.5 sm:mt-2 leading-relaxed">
            Carnes nobres com procedência de frigoríficos inspecionados. Nossos açougueiros preparam o corte do jeito que você gosta.
          </p>
        </div>

        <div class="flex flex-col items-center md:items-start group">
          <div class="w-12 h-12 rounded-2xl bg-white/10 flex items-center justify-center text-2xl mb-3 sm:mb-4 animate-float group-hover:scale-110 transition-transform">
            💳
          </div>
          <h3 class="text-base sm:text-lg font-bold group-hover:text-violet-300 transition-colors">Pague com PIX ou no WhatsApp</h3>
          <p class="text-xs text-brand-100/90 mt-1.5 sm:mt-2 leading-relaxed">
            Monte seu carrinho no site e pague na hora com PIX, ou mande sua listinha no WhatsApp para entrega a domicílio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Seção Informativa: Horário e Localização Rápida -->
  <section class="reveal-on-scroll max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-8 mb-8 sm:mb-12">
    <div class="bg-white dark:bg-slate-900 rounded-2xl sm:rounded-3xl p-5 sm:p-10 border border-slate-200/90 dark:border-slate-800 shadow-card flex flex-col lg:flex-row items-center justify-between gap-6 sm:gap-8">
      <div class="space-y-2.5 sm:space-y-3 w-full lg:w-auto">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-brand-700 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/70 border border-brand-200/50 dark:border-brand-800/80 px-3 py-1 rounded-full shadow-sm">
          Visite Nossa Loja Física
        </span>
        <h2 class="text-xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Estamos de portas abertas para <span class="animate-text-violet font-black">te receber!</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          {loja.endereco} &bull; {loja.cidadeBairro}
        </p>
        <div class="flex flex-wrap gap-2.5 sm:gap-4 pt-1 sm:pt-2 text-xs font-medium text-slate-700 dark:text-slate-300">
          <span class="bg-slate-100 dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700">
            📅 {loja.horarioSemana}
          </span>
          <span class="bg-slate-100 dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700">
            ☀️ {loja.horarioDomingo}
          </span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-2.5 sm:gap-3 w-full lg:w-auto">
        <a
          href="/localizacao"
          class="w-full sm:w-auto text-center px-6 py-3 sm:py-3.5 rounded-xl bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 text-white font-bold text-xs sm:text-sm shadow transition hover:scale-[1.02]"
        >
          Ver Rota no Mapa
        </a>
        <a
          href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de fazer uma encomenda.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-shine w-full sm:w-auto text-center px-6 py-3 sm:py-3.5 rounded-xl bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm shadow transition hover:scale-[1.02]"
        >
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
