---
interface Props {
  slug: string;
  nome: string;
  preco: number;
  precoPromocional?: number | null;
  unidade: string;
  categoria: string;
  descricao: string;
  imagem: string;
  disponivel: boolean;
  destaque?: boolean;
  whatsapp?: string;
}

const {
  slug,
  nome,
  preco,
  precoPromocional,
  unidade = 'un',
  categoria,
  descricao,
  imagem,
  disponivel = true,
  destaque = false,
  whatsapp = '5511999998888',
} = Astro.props;

// Formatação brasileira de moeda
const formatCurrency = (val: number) => {
  return val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
};

// Cálculo de percentual de desconto se houver promoção
const temPromocao = precoPromocional && precoPromocional < preco;
const percentualDesconto = temPromocao
  ? Math.round(((preco - precoPromocional) / preco) * 100)
  : 0;

const precoFinal = temPromocao ? precoPromocional : preco;
---

<div class={`group relative flex flex-col bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-card hover:shadow-card-hover hover:border-brand-300 dark:hover:border-brand-500 transition-all duration-300 overflow-hidden ${!disponivel ? 'opacity-70 grayscale-[30%]' : ''}`}>
  
  <!-- Badges Flutuantes -->
  <div class="absolute top-3 left-3 z-10 flex flex-col gap-1.5 items-start">
    {temPromocao && disponivel && (
      <span class="inline-flex items-center gap-1 bg-gradient-to-r from-red-600 to-promo-600 text-white text-[11px] font-extrabold px-2.5 py-1 rounded-full shadow-md tracking-wider uppercase">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.633 1.09-1.026 1.838-.727 1.385-1.745 3.32-3.177 5.642C4.375 13.064 3 15.65 3 17a4 4 0 008 0c0-.853-.298-1.636-.8-2.26a1 1 0 01.378-1.558c.995-.49 1.954-1.22 2.76-2.128.825-.928 1.488-2.036 1.914-3.238.163-.46.305-.924.423-1.39A8.995 8.995 0 0016 7a1 1 0 00-1-1c-.88 0-1.704.28-2.605.553z" clip-rule="evenodd"></path></svg>
        {percentualDesconto}% OFF
      </span>
    )}
    {destaque && disponivel && !temPromocao && (
      <span class="bg-brand-600 text-white text-[11px] font-bold px-2 py-0.5 rounded-full shadow-sm">
        Destaque
      </span>
    )}
    {!disponivel && (
      <span class="bg-slate-700 text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow-sm uppercase tracking-wide">
        Esgotado
      </span>
    )}
  </div>

  <!-- Foto do Produto com Link -->
  <a href={`/produtos/${slug}`} class="relative block h-48 sm:h-52 w-full overflow-hidden bg-slate-100 dark:bg-slate-800 focus:outline-none">
    <img
      src={imagem}
      alt={nome}
      loading="lazy"
      class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
  </a>

  <!-- Informações do Produto -->
  <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
    <div>
      <!-- Categoria com link para filtro -->
      <a
        href={`/produtos?categoria=${encodeURIComponent(categoria)}`}
        class="inline-block text-[11px] uppercase tracking-wider font-semibold text-brand-700 dark:text-emerald-300 hover:text-brand-800 bg-brand-50 dark:bg-brand-950/70 border border-brand-200/50 dark:border-brand-800/60 px-2 py-0.5 rounded-md mb-2"
      >
        {categoria}
      </a>

      <!-- Nome do Produto -->
      <h3 class="font-bold text-slate-900 dark:text-white text-base leading-snug line-clamp-2 group-hover:text-brand-700 dark:group-hover:text-emerald-400 transition-colors">
        <a href={`/produtos/${slug}`}>
          {nome}
        </a>
      </h3>

      <!-- Descrição Curta -->
      <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1.5 leading-relaxed">
        {descricao}
      </p>
    </div>

    <!-- Seção de Preços e Ações -->
    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800">
      <div class="flex items-baseline gap-2">
        {temPromocao ? (
          <div class="flex flex-col">
            <span class="text-xs text-slate-400 dark:text-slate-500 line-through">
              {formatCurrency(preco)}
            </span>
            <div class="flex items-baseline gap-1">
              <span class="text-xl sm:text-2xl font-black text-promo-600 dark:text-promo-400">
                {formatCurrency(precoPromocional!)}
              </span>
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                /{unidade}
              </span>
            </div>
          </div>
        ) : (
          <div class="flex items-baseline gap-1">
            <span class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
              {formatCurrency(preco)}
            </span>
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
              /{unidade}
            </span>
          </div>
        )}
      </div>

      <!-- Botões de Ação do Card -->
      <div class="mt-3.5 flex flex-col gap-2">
        <!-- Botão Adicionar ao Carrinho -->
        {disponivel ? (
          <button
            type="button"
            class="btn-add-carrinho w-full flex items-center justify-center gap-2 text-xs font-bold text-white bg-brand-600 hover:bg-brand-500 active:scale-95 px-3 py-2.5 rounded-xl shadow-sm hover:shadow transition-all"
            data-slug={slug}
            data-nome={nome}
            data-preco={precoFinal}
            data-unidade={unidade}
            data-imagem={imagem}
          >
            <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span class="btn-text">Adicionar ao Carrinho</span>
          </button>
        ) : (
          <button
            disabled
            class="w-full flex items-center justify-center text-xs font-medium text-slate-400 dark:text-slate-600 bg-slate-100 dark:bg-slate-800 py-2.5 rounded-xl cursor-not-allowed"
          >
            Indisponível
          </button>
        )}

        <!-- Link secundário de detalhes -->
        <a
          href={`/produtos/${slug}`}
          class="flex items-center justify-center text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 py-1.5 rounded-lg transition"
        >
          Ver detalhes do produto &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Usa delegação de eventos no document para garantir que funcione
  // mesmo quando o carrinhoMercado ainda não foi inicializado
  function handleAddToCart(btn: HTMLButtonElement) {
    const slug = btn.getAttribute('data-slug') || '';
    const nome = btn.getAttribute('data-nome') || '';
    const preco = parseFloat(btn.getAttribute('data-preco') || '0');
    const unidade = btn.getAttribute('data-unidade') || 'un';
    const imagem = btn.getAttribute('data-imagem') || '';

    if (window.carrinhoMercado) {
      window.carrinhoMercado.adicionar({
        slug,
        nome,
        preco,
        unidade,
        imagem,
      });

      // Feedback visual
      const textSpan = btn.querySelector('.btn-text');
      if (textSpan) {
        const originalText = textSpan.textContent;
        textSpan.textContent = 'Adicionado! ✓';
        btn.classList.remove('bg-brand-600', 'hover:bg-brand-500');
        btn.classList.add('bg-emerald-600');
        setTimeout(() => {
          if (textSpan) textSpan.textContent = originalText;
          btn.classList.add('bg-brand-600', 'hover:bg-brand-500');
          btn.classList.remove('bg-emerald-600');
        }, 1500);
      }
    } else {
      // Carrinho ainda não carregou, tenta novamente em breve
      console.warn('[Carrinho] carrinhoMercado não disponível ainda, tentando novamente...');
      setTimeout(() => handleAddToCart(btn), 300);
    }
  }

  // Delegação de eventos: captura cliques em qualquer botão .btn-add-carrinho
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('.btn-add-carrinho') as HTMLButtonElement | null;
    if (btn) {
      e.preventDefault();
      handleAddToCart(btn);
    }
  });
</script>
