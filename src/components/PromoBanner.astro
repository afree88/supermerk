---
interface Props {
  loja: {
    bannerTitulo: string;
    bannerSubtitulo: string;
    whatsapp: string;
  };
}

const { loja } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-brand-950 to-emerald-950 text-white rounded-2xl sm:rounded-3xl mx-3 sm:mx-6 lg:mx-8 my-4 sm:my-6 shadow-2xl border border-brand-800/60">
  <!-- Padrão decorativo de pontos sutis -->
  <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>

  <!-- Orbes luminosos animados no fundo para profundidade atmosférica -->
  <div class="absolute -top-20 -left-20 w-80 h-80 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none animate-glow-orb-1"></div>
  <div class="absolute -bottom-24 right-1/4 w-80 h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none animate-glow-orb-2"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-16 lg:py-20 flex flex-col lg:flex-row items-center justify-between gap-8 sm:gap-10">
    <div class="max-w-2xl text-center lg:text-left w-full">
      <!-- Tag / Badge de Altíssimo Contraste com micro-animação -->
      <div class="inline-flex items-center gap-2 bg-amber-400 text-slate-950 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-black mb-4 sm:mb-6 shadow-lg tracking-wider uppercase hover:scale-105 transition-transform duration-300">
        <span class="flex h-2 w-2 rounded-full bg-red-600 animate-ping"></span>
        <span class="tracking-wide">SUPER OFERTAS DA SEMANA</span>
      </div>

      <!-- Título Principal com Shimmer elegante de letras -->
      <h1 class="text-2xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight font-heading drop-shadow-md">
        <span class="animate-text-shimmer">{loja.bannerTitulo || 'Economia de Verdade para Sua Casa'}</span>
      </h1>

      <!-- Subtítulo em branco puro e legível -->
      <p class="mt-3 sm:mt-6 text-xs sm:text-lg text-slate-100 font-medium leading-relaxed max-w-xl">
        {loja.bannerSubtitulo || 'Frutas fresquinhas colhidas no dia, carnes selecionadas e os itens essenciais da sua despensa com o menor preço da região.'}
      </p>

      <!-- Botões de Ação com reflexo de luz (Shine) -->
      <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-2.5 sm:gap-4 w-full">
        <a
          href="/produtos"
          class="btn-shine w-full sm:w-auto text-center px-5 py-3 sm:py-3.5 rounded-xl bg-promo-500 hover:bg-promo-600 text-white font-extrabold text-xs sm:text-base shadow-xl shadow-promo-500/40 hover:scale-[1.02] sm:hover:scale-105 transition-all duration-200"
        >
          Explorar Todos os Produtos &rarr;
        </a>

        <a
          href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de saber as ofertas de hoje do Mercado Bom Preço.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 sm:py-3.5 rounded-xl bg-slate-900/80 hover:bg-slate-900 text-white font-bold text-xs sm:text-base border border-emerald-400/30 transition-all duration-200 shadow-md hover:scale-[1.02]"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current text-emerald-400" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>Folheto no WhatsApp</span>
        </a>
      </div>

      <!-- Diferenciais em Caixas com Fundo Escuro Sólido e Textos 100% Nítidos -->
      <div class="mt-6 sm:mt-10 grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-3.5 pt-4 sm:pt-6 border-t border-white/15 text-left">
        <div class="bg-black/40 border border-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3.5 backdrop-blur-sm hover:border-amber-400/40 transition-colors">
          <span class="block text-lg sm:text-2xl font-black text-amber-300">100% Fresco</span>
          <span class="text-[11px] sm:text-xs text-slate-200 font-semibold block mt-0.5">Hortifruti diário</span>
        </div>
        <div class="bg-black/40 border border-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3.5 backdrop-blur-sm hover:border-promo-400/40 transition-colors">
          <span class="block text-lg sm:text-2xl font-black text-promo-400">Açougue</span>
          <span class="text-[11px] sm:text-xs text-slate-200 font-semibold block mt-0.5">Corte sob medida</span>
        </div>
        <div class="col-span-2 sm:col-span-1 bg-black/40 border border-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3.5 backdrop-blur-sm hover:border-emerald-400/40 transition-colors">
          <span class="block text-lg sm:text-2xl font-black text-emerald-400">Entrega</span>
          <span class="text-[11px] sm:text-xs text-slate-200 font-semibold block mt-0.5">Rápida no bairro</span>
        </div>
      </div>
    </div>

    <!-- Destaque visual direito: Card Promocional com leve flutuação 3D -->
    <div class="relative w-full max-w-sm lg:max-w-md animate-float">
      <div class="relative bg-slate-900/95 dark:bg-slate-950/95 p-6 sm:p-7 rounded-3xl border-2 border-emerald-500/40 shadow-2xl text-white">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-black uppercase tracking-wider text-amber-300">Destaque de Hoje</span>
          <span class="bg-red-600 text-white text-[11px] font-black px-3 py-1 rounded-full uppercase shadow animate-flame">Até 30% OFF</span>
        </div>

        <div class="h-44 w-full rounded-2xl overflow-hidden mb-5 bg-slate-800 relative border border-slate-700 group">
          <img
            src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=600&q=80"
            alt="Supermercado Bom Preço"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
          <div class="absolute bottom-3 left-4 right-4 text-white">
            <span class="text-xs font-bold text-emerald-300 block uppercase tracking-wide">Feira Especial</span>
            <span class="text-xl font-black">Quarta e Quinta Verde</span>
          </div>
        </div>

        <!-- Lista com Textos em Branco e Alto Contraste -->
        <div class="space-y-2.5 text-sm">
          <div class="flex items-center gap-2.5 bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/60 hover:bg-slate-800 transition-colors">
            <span class="text-emerald-400 font-black text-base shrink-0">✓</span>
            <span class="font-bold text-white text-xs sm:text-sm">Frutas e verduras selecionadas</span>
          </div>
          <div class="flex items-center gap-2.5 bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/60 hover:bg-slate-800 transition-colors">
            <span class="text-emerald-400 font-black text-base shrink-0">✓</span>
            <span class="font-bold text-white text-xs sm:text-sm">Pão francês crocante a todo instante</span>
          </div>
          <div class="flex items-center gap-2.5 bg-slate-800/80 p-2.5 rounded-xl border border-slate-700/60 hover:bg-slate-800 transition-colors">
            <span class="text-emerald-400 font-black text-base shrink-0">✓</span>
            <span class="font-bold text-white text-xs sm:text-sm">Cortes nobres com pesagem honesta</span>
          </div>
        </div>

        <a
          href="/produtos?categoria=Frutas+e+Verduras"
          class="btn-shine mt-6 w-full inline-flex items-center justify-center py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm transition shadow-lg shadow-emerald-500/25 hover:scale-[1.02]"
        >
          Aproveitar Ofertas de Hortifruti &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

