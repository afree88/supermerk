---
interface Props {
  activeCategory?: string;
  baseUrl?: string;
}

const { activeCategory = '', baseUrl = '/produtos' } = Astro.props;

const categorias = [
  { name: 'Todas', icon: '🛒', count: 12, color: 'bg-slate-100 text-slate-800' },
  { name: 'Frutas e Verduras', icon: '🍎', count: 2, color: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
  { name: 'Carnes e Aves', icon: '🥩', count: 2, color: 'bg-rose-50 text-rose-800 border-rose-200' },
  { name: 'Laticínios', icon: '🧀', count: 2, color: 'bg-amber-50 text-amber-800 border-amber-200' },
  { name: 'Mercearia', icon: '🌾', count: 3, color: 'bg-orange-50 text-orange-800 border-orange-200' },
  { name: 'Limpeza', icon: '✨', count: 1, color: 'bg-cyan-50 text-cyan-800 border-cyan-200' },
  { name: 'Bebidas', icon: '🧃', count: 1, color: 'bg-purple-50 text-purple-800 border-purple-200' },
  { name: 'Padaria', icon: '🥖', count: 1, color: 'bg-yellow-50 text-yellow-800 border-yellow-200' },
  { name: 'Higiene', icon: '🧼', count: 1, color: 'bg-teal-50 text-teal-800 border-teal-200' },
];
---

<div class="w-full">
  <div class="flex items-center gap-2.5 overflow-x-auto pb-3 pt-1 scrollbar-none no-scrollbar">
    {categorias.map((cat) => {
      const isSelected = (!activeCategory && cat.name === 'Todas') || activeCategory === cat.name;
      const targetHref = cat.name === 'Todas' ? baseUrl : `${baseUrl}?categoria=${encodeURIComponent(cat.name)}`;
      
      return (
        <a
          href={targetHref}
          class={`shrink-0 inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs sm:text-sm font-semibold transition-all duration-200 border shadow-sm ${
            isSelected
              ? 'bg-brand-600 dark:bg-brand-500 text-white border-brand-600 shadow-brand-500/25 shadow-md scale-[1.02]'
              : 'bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border-slate-200 dark:border-slate-800 hover:border-brand-300 dark:hover:border-brand-600 hover:bg-slate-50 dark:hover:bg-slate-800'
          }`}
        >
          <span class="text-base">{cat.icon}</span>
          <span>{cat.name}</span>
        </a>
      );
    })}
  </div>
</div>
