---
interface Props {
  loja: {
    nomeLoja: string;
    slogan?: string;
    telefone: string;
    whatsapp: string;
    endereco: string;
    cidadeBairro: string;
    horarioSemana: string;
    horarioDomingo: string;
  };
}

const { loja } = Astro.props;
const currentYear = new Date().getFullYear();

const categorias = [
  'Frutas e Verduras',
  'Carnes e Aves',
  'Laticínios',
  'Mercearia',
  'Limpeza',
  'Bebidas',
  'Padaria',
  'Higiene'
];
---

<footer class="bg-slate-900 text-slate-300 pt-14 pb-8 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Coluna 1: Sobre o Mercado -->
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-9 h-9 rounded-lg bg-brand-600 flex items-center justify-center text-white font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <span class="text-xl font-bold text-white tracking-tight">{loja.nomeLoja}</span>
        </div>
        <p class="text-sm text-slate-400 mb-5 leading-relaxed">
          {loja.slogan || 'O supermercado preferido da sua família no bairro. Produtos frescos, preços justos e atendimento de confiança todos os dias.'}
        </p>
        <div class="space-y-2 text-xs text-slate-400">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Açougue próprio com carnes frescas</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Hortifruti abastecido diariamente</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Pão quentinho a toda hora</span>
          </div>
        </div>
      </div>

      <!-- Coluna 2: Categorias Principais -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Nossos Departamentos</h3>
        <ul class="space-y-2 text-sm">
          {categorias.slice(0, 6).map((cat) => (
            <li>
              <a
                href={`/produtos?categoria=${encodeURIComponent(cat)}`}
                class="hover:text-white transition-colors hover:translate-x-1 inline-block"
              >
                {cat}
              </a>
            </li>
          ))}
          <li>
            <a href="/produtos" class="text-brand-400 hover:text-brand-300 font-medium inline-flex items-center gap-1 mt-1">
              Ver todas as categorias &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna 3: Horários e Atendimento -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Horário de Funcionamento</h3>
        <ul class="space-y-3 text-sm text-slate-300">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-brand-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <div>
              <strong class="block text-white font-medium text-xs">Segunda a Sábado</strong>
              <span class="text-slate-400 text-xs">{loja.horarioSemana}</span>
            </div>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-brand-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <div>
              <strong class="block text-white font-medium text-xs">Domingos e Feriados</strong>
              <span class="text-slate-400 text-xs">{loja.horarioDomingo}</span>
            </div>
          </li>
        </ul>

        <div class="mt-5">
          <h4 class="text-xs uppercase text-slate-400 font-semibold mb-2">Formas de Pagamento</h4>
          <div class="flex flex-wrap gap-2 text-[11px] text-slate-300">
            <span class="bg-slate-800 px-2 py-1 rounded border border-slate-700">PIX</span>
            <span class="bg-slate-800 px-2 py-1 rounded border border-slate-700">Cartão Débito/Crédito</span>
            <span class="bg-slate-800 px-2 py-1 rounded border border-slate-700">VR / VA</span>
            <span class="bg-slate-800 px-2 py-1 rounded border border-slate-700">Dinheiro</span>
          </div>
        </div>
      </div>

      <!-- Coluna 4: Onde Estamos & Contato -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Onde Estamos</h3>
        <p class="text-sm text-slate-300 mb-2 leading-relaxed">
          {loja.endereco}<br />
          {loja.cidadeBairro}
        </p>
        <p class="text-sm text-slate-300 mb-4">
          Telefone: <strong class="text-white">{loja.telefone}</strong>
        </p>

        <a
          href="/localizacao"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-400 hover:text-brand-300 underline underline-offset-4"
        >
          <span>📍</span> Ver rota e mapa de localização
        </a>

        <div class="mt-6">
          <a
            href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de fazer um pedido.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-3 py-2 rounded-lg transition"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            <span>Pedir pelo WhatsApp</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Barra Inferior de Direitos e Link do Admin -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} {loja.nomeLoja}. Todos os direitos reservados. Preços e ofertas válidos enquanto durarem os estoques.</p>
      <div class="flex items-center gap-4">
        <a href="/sobre" class="hover:text-slate-400">Sobre Nós</a>
        <a href="/contato" class="hover:text-slate-400">Contato</a>
        <a href="/admin" class="text-slate-400 hover:text-white flex items-center gap-1 bg-slate-800/80 px-2.5 py-1 rounded border border-slate-700">
          <svg class="w-3 h-3 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          Área do Gerente (CMS)
        </a>
      </div>
    </div>
  </div>
</footer>
