---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const configEntry = await getEntry('configuracoes', 'loja');
const loja = configEntry?.data ?? {
  nomeLoja: 'Mercado Bom Preço',
  slogan: 'Economia e qualidade pertinho de você!',
  telefone: '(11) 3456-7890',
  whatsapp: '5511999998888',
  endereco: 'Rua das Flores, 123 - Centro',
  cidadeBairro: 'São Paulo, SP',
  horarioSemana: '07h30 às 20h30',
  horarioDomingo: '08h00 às 13h30',
  bannerAviso: '🎉 Ofertas especiais toda semana!',
  googleMapsUrl: 'https://maps.google.com',
  chavePix: '11999998888',
  tipoChavePix: 'Celular / WhatsApp',
  titularPix: 'Mercado Bom Preço Ltda',
};

const {
  title = `${loja.nomeLoja} - Ofertas, Qualidade e Economia Todos os Dias`,
  description = loja.slogan || 'Confira nossas ofertas de hortifruti fresco, carnes nobres, laticínios e itens de mercearia pelo menor preço.',
  image = '/favicon.svg'
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://mercadobompreco.netlify.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Netlify Identity Widget para Autenticação do CMS / Admin -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <!-- Script Inline para evitar Flash no Dark Mode -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- SEO Primário -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteUrl)} />

    <!-- Fontes do Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 dark:bg-slate-950 font-sans text-slate-800 dark:text-slate-100 antialiased transition-colors duration-200">
    <!-- Header com navegação, tema dark e botão do carrinho -->
    <Header loja={loja} />

    <!-- Drawer do Carrinho com Pagamento PIX (deve vir antes do main para inicializar window.carrinhoMercado) -->
    <CartDrawer loja={loja} />

    <!-- Conteúdo principal da página -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Rodapé -->
    <Footer loja={loja} />

    <!-- Botões Flutuantes (WhatsApp e Carrinho Rápido) -->
    <div class="fixed bottom-6 right-6 z-40 flex flex-col gap-3 items-end">
      <!-- Botão Flutuante do Carrinho -->
      <button
        id="btn-cart-floating"
        type="button"
        class="relative flex items-center gap-2.5 rounded-full bg-brand-600 dark:bg-brand-500 hover:bg-brand-500 dark:hover:bg-brand-400 text-white font-bold p-3.5 sm:px-4 sm:py-3 shadow-xl hover:shadow-2xl hover:scale-105 active:scale-95 transition-all focus:outline-none focus:ring-4 focus:ring-brand-300"
        aria-label="Abrir carrinho de compras"
      >
        <svg class="w-6 h-6 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span class="hidden sm:inline text-sm">Meu Carrinho</span>
        <span
          id="cart-badge-floating"
          class="hidden absolute -top-1.5 -right-1.5 min-w-[22px] h-[22px] px-1 bg-promo-500 text-white text-[11px] font-black rounded-full flex items-center justify-center shadow border-2 border-white dark:border-slate-950"
        >
          0
        </span>
      </button>

      <!-- Botão Flutuante do WhatsApp -->
      <a
        href={`https://wa.me/${loja.whatsapp}?text=${encodeURIComponent('Olá! Gostaria de informações sobre produtos e ofertas do Mercado Bom Preço.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold p-3 sm:px-3.5 sm:py-2.5 shadow-lg hover:shadow-xl hover:scale-105 transition-all focus:outline-none focus:ring-4 focus:ring-emerald-300"
        aria-label="Fale conosco pelo WhatsApp"
        title="WhatsApp Oficial"
      >
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span class="hidden sm:inline text-xs">WhatsApp</span>
      </a>
    </div>

    <script>
      // Atualiza badge flutuante do carrinho
      const floatingBtn = document.getElementById('btn-cart-floating');
      const floatingBadge = document.getElementById('cart-badge-floating');

      function updateFloatingBadge() {
        try {
          const raw = localStorage.getItem('bompreco_cart_v1');
          const cart = raw ? JSON.parse(raw) : [];
          const totalQtd = cart.reduce((acc: number, item: any) => acc + (item.quantidade || 0), 0);

          if (floatingBadge) {
            if (totalQtd > 0) {
              floatingBadge.textContent = String(totalQtd);
              floatingBadge.classList.remove('hidden');
              floatingBadge.classList.add('flex');
            } else {
              floatingBadge.classList.add('hidden');
              floatingBadge.classList.remove('flex');
            }
          }
        } catch {
          // ignore
        }
      }

      floatingBtn?.addEventListener('click', () => {
        if (window.carrinhoMercado) {
          window.carrinhoMercado.abrir();
        }
      });

      window.addEventListener('cart:updated', updateFloatingBadge);
      updateFloatingBadge();
    </script>

    <!-- Redirecionamento pós-login no Netlify Identity para o Painel Admin -->
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", (user) => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </body>
</html>
